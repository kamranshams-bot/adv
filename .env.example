# Copy this file to .env and fill in your values. Never commit .env.

# Full text of the service account JSON key (one line), from
# IAM & Admin > Service Accounts > adv-media-search > Keys > Add key (JSON).
# The service account needs the "Vertex AI User" role, and the project needs
# the Agent Platform (Vertex AI) API enabled and billing turned on.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional
# VERTEX_MODEL=gemini-2.5-flash
# VERTEX_LOCATION=global
PORT=3000
